diff --git a/codebase/desktop/tests/preferences-storage.test.js b/codebase/desktop/tests/preferences-storage.test.js
new file mode 100644
--- /dev/null
+++ b/codebase/desktop/tests/preferences-storage.test.js
@@ -0,0 +1,43 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const vm = require("node:vm");
+
+test("overlapping native and renderer preference changes persist and publish in order", async () => {
+  const handlers = new Map(), snapshots = [], commands = [], renames = [];
+  let finishFirstWrite;
+  const file = "application-preferences.json";
+  const source = fs.readFileSync(require.resolve("../main.js"), "utf8");
+  const context = vm.createContext({
+    app: { getPath: () => "." }, applicationPreferences: { renderingMode: "auto" }, renderingMode: "auto",
+    applicationPreferencesPath: () => file, sanitizeApplicationPreferences: value => value,
+    ipcMain: { handle: (name, callback) => handlers.set(name, callback), on() {} },
+    validateSender: () => ({ role: "main" }), windows: new Map(),
+    buildMenu: () => commands.push(context.renderingMode), sendCommand() {},
+    fs: { promises: {
+      async mkdir() {},
+      writeFile(_temporary, text) {
+        snapshots.push(JSON.parse(text));
+        if (snapshots.length === 1) return new Promise(resolve => { finishFirstWrite = resolve; });
+        return Promise.resolve();
+      },
+      async rename(...args) { renames.push(args); },
+    } },
+  });
+  const first = source.indexOf("let applicationPreferencesCommit");
+  vm.runInContext(source.slice(first < 0 ? source.indexOf("function persistApplicationPreferences(") : first,
+    source.indexOf("function directoryPreference(")) +
+    source.slice(source.indexOf("function registerIpc()"), source.indexOf("function updateWindowDocumentState()")) +
+    "\nregisterIpc();", context);
+  const native = context.setRenderingMode("cpu");
+  const renderer = handlers.get("desktop:set-preferences")({}, { renderingMode: "gpu" });
+  await new Promise(resolve => setImmediate(resolve));
+  assert.deepEqual(snapshots, [{ renderingMode: "cpu" }]);
+  assert.deepEqual(commands, []);
+  finishFirstWrite();
+  assert.equal(await native, true);
+  assert.equal((await renderer).renderingMode, "gpu");
+  assert.deepEqual(commands, ["cpu", "gpu"]);
+  assert.deepEqual(snapshots, [{ renderingMode: "cpu" }, { renderingMode: "gpu" }]);
+  assert.deepEqual(renames, [[file + ".tmp", file], [file + ".tmp", file]]);
+});
