+@pytest.mark.parametrize("change", ["interpretation", "reference-white"])
+def test_raw_redevelopment_rejects_pixels_prepared_before_a_source_context_change(tmp_path: Path, change: str) -> None:
+    source = tmp_path / "source.png"
+    Image.new("RGB", (64, 32), (80, 120, 160)).save(source)
+    sessions = SessionStore()
+    initial = sessions.create_session(source, hdr_reference_white_nits=203)
+    developed = sessions.prepare_session(source, hdr_reference_white_nits=203)
+
+    if change == "interpretation":
+        sessions.update_source_interpretation(initial.session_id, SourceInterpretationOverride(color_space="Display P3"))
+    else:
+        sessions.apply_edit_commands(initial.session_id, [EditCommand(expected_revision=0,
+            command_type="set_hdr_reference_white", payload={"hdr_reference_white_nits": 100})])
+    current = sessions.get(initial.session_id)
+    previous = current.image.copy()
+    revision = current.edit_revision
+    if change == "interpretation":
+        assert not np.array_equal(developed.image, previous)
+
+    with pytest.raises(ValueError, match="RAW re-development source no longer matches"):
+        sessions.redevelop_session(initial.session_id, developed)
+    assert sessions.get(initial.session_id) is current and current.edit_revision == revision
+    np.testing.assert_array_equal(current.image, previous)
+
+
