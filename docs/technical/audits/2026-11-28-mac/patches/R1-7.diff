+
+test('a cancelled quit does not turn a later ordinary window close into app shutdown', async () => {
+  let closes = 0, shutdowns = 0;
+  const mainWindow = { close: () => closes++ };
+  const context = vm.createContext({
+    quitRequested: true, forceClose: false, mainWindow, windowFailure: null,
+    documentState: { dirty: true }, choosePhotoTransition: () => 'cancel',
+    leaveCurrentPhoto: require('../../frontend/photo-transition').leaveCurrentPhoto,
+    beginShutdown: () => shutdowns++,
+  });
+  const source = fs.readFileSync(path.join(__dirname, '../main.js'), 'utf8');
+  vm.runInContext(source.slice(source.indexOf('async function requestClose()'),
+    source.indexOf('async function beginShutdown()')), context);
+  await context.requestClose();
+  assert.equal(closes, 0);
+  context.documentState.dirty = false;
+  await context.requestClose();
+  assert.equal(closes, 1);
+  assert.equal(shutdowns, 0);
+});
+
+test('a cancelled sidecar quit does not turn the next close into app shutdown', async () => {
+  let closes = 0, shutdowns = 0;
+  const window = { pendingSidecarClose: true, close: () => closes++ };
+  const complete = setupClose(window, { requested: true, shutdown: () => shutdowns++ });
+  await complete(false);
+  window.pendingSidecarClose = true;
+  await complete(true);
+  assert.equal(closes, 1);
+  assert.equal(shutdowns, 0);
+});
