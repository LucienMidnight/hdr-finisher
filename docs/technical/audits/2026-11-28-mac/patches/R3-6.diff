+test("a Retouch acknowledgement cannot overwrite a slider edit made during source refresh", async () => {
+  const sourceRefresh = Promise.withResolvers(), refreshStarted = Promise.withResolvers();
+  const initial = { hdr: { exposure: 0 }, sdr: {} };
+  const state = { session: { session_id: "photo" }, currentView: "hdr", editRevision: 1,
+    adjustments: structuredClone(initial), editDocument: { global_adjustments: initial, repairs: [] },
+    globalEditGeneration: 0, globalEditDirty: false };
+  const requests = [];
+  const context = vm.createContext({
+    state, window: {}, console,
+    geometryDraftActive: () => false, geometrySignature: () => "frame",
+    stablePreviewJson: JSON.stringify,
+    resetRepairSource: async () => {
+      if (requests.length === 1) {
+        refreshStarted.resolve();
+        await sourceRefresh.promise;
+      }
+    },
+    recordAcknowledgedLocals() {}, renderLocalAdjustments() {}, syncProjectBadge() {},
+    updateExportAvailability() {}, invalidatePreview() {}, debouncePreview() {},
+    status: { get() {} }, safeJson: response => response.json(),
+    fetch: async (_url, { body }) => {
+      const command = JSON.parse(body).commands[0];
+      requests.push(command);
+      return { ok: true, json: async () => ({ revision: command.expected_revision + 1, dirty: true,
+        document: { global_adjustments: structuredClone(command.payload.adjustments || initial), repairs: [{ id: "repair" }] } }) };
+    },
+  });
+  vm.runInContext(declarations("queueEditCommand", "syncGlobalEditState", "markGlobalEditDirty"), context);
+  const repair = context.queueEditCommand("set_repairs", { repairs: [{ id: "repair" }] });
+  await refreshStarted.promise;
+  state.adjustments.hdr.exposure = 0.7;
+  context.markGlobalEditDirty();
+  sourceRefresh.resolve();
+  assert.equal(await repair, true);
+  assert.deepEqual(state.editDocument.repairs, [{ id: "repair" }]);
+  assert.equal(state.adjustments.hdr.exposure, 0.7);
+  assert.equal(await context.syncGlobalEditState(), true);
+  assert.equal(requests[1].payload.adjustments.hdr.exposure, 0.7);
+});
