+
+
+def test_import_cannot_publish_old_pixels_with_a_replaced_files_fingerprint(tmp_path, monkeypatch):
+    from hdr_finisher import sessions
+    from hdr_finisher.loader import LoaderError
+
+    active = tmp_path / 'active.png'
+    photo = tmp_path / 'photo.png'
+    replacement = tmp_path / 'replacement.png'
+    for path, color in ((active, (20, 50, 80)), (photo, (150, 80, 15)), (replacement, (5, 100, 180))):
+        Image.new('RGB', (24, 16), color).save(path)
+    store = SessionStore()
+    initial = store.get(store.create_session(active).session_id)
+    expected = initial.image.copy()
+    load = sessions.load_image
+
+    def replace_after_decode(path, **kwargs):
+        decoded = load(path, **kwargs)
+        replacement.replace(path)
+        return decoded
+
+    monkeypatch.setattr(sessions, 'load_image', replace_after_decode)
+    with pytest.raises(LoaderError, match='Photo changed during decoding'):
+        store.create_session(photo)
+    assert store.current() is initial
+    np.testing.assert_array_equal(initial.image, expected)
+    with Image.open(photo) as image:
+        assert image.getpixel((0, 0)) == (5, 100, 180)
