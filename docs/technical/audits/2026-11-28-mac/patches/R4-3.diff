+def test_redeveloping_the_same_session_does_not_reuse_its_old_denoise_model(tmp_path, monkeypatch) -> None:
+    from fastapi.testclient import TestClient
+    from PIL import Image
+    from hdr_finisher import main, sessions
+    from hdr_finisher.models import RawImportSettings
+
+    source = tmp_path / "sensor.png"
+    Image.new("RGB", (32, 24), (80, 120, 160)).save(source)
+    store = sessions.SessionStore()
+    monkeypatch.setattr(main, "store", store)
+    initial = store.create_session(source)
+    old_session = store.get(initial.session_id)
+    old_epoch = old_session.render_cache.source_epoch
+    old_pixels = old_session.image.copy()
+
+    def measure(image):
+        return SimpleNamespace(as_dict=lambda: {"sample": float(image[12, 12, 0])})
+
+    monkeypatch.setattr(da, "estimate_adaptive_model", measure)
+    client = TestClient(main.app)
+    url = f"/api/session/{initial.session_id}/denoise-model/hdr?long_edge=256"
+    before = client.get(url)
+    assert before.status_code == 200 and before.json() == measure(old_pixels).as_dict()
+
+    load = sessions.load_image
+
+    def redecode(*args, **kwargs):
+        image, descriptor, metadata, analysis, reference = load(*args, **kwargs)
+        image[12, 12, 0] = 0
+        return image, descriptor, metadata, analysis, reference
+
+    monkeypatch.setattr(sessions, "load_image", redecode)
+    old_session.render_cache.release_development_cache()  # Import job reclaims the old cache before decoding.
+    developed = store.prepare_session(source, raw_import_settings=RawImportSettings())
+    expected = developed.image.copy()
+    store.redevelop_session(initial.session_id, developed)
+    after = client.get(url)
+    assert after.status_code == 200 and after.json() == measure(expected).as_dict()
+    np.testing.assert_array_equal(store.get(initial.session_id).image, expected)
+    assert developed.render_cache.source_epoch > old_session.render_cache.source_epoch > old_epoch
+
+
