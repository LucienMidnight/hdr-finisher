diff --git a/codebase/desktop/tests/grading-preset-list.test.js b/codebase/desktop/tests/grading-preset-list.test.js
new file mode 100644
--- /dev/null
+++ b/codebase/desktop/tests/grading-preset-list.test.js
@@ -0,0 +1,35 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const vm = require('node:vm');
+
+test('other grading groups do not consume the current group\'s listing budget', t => {
+  const fsOrder = [];
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hdr-group-cap-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const main = fs.readFileSync(require.resolve('../main.js'), 'utf8');
+  const context = vm.createContext({
+    fs: { ...fs, readdirSync: () => fsOrder }, path, crypto,
+    GRADING_PRESET_GROUPS: new Set(['hdr-tone', 'sdr-tone']),
+    gradingPresetDirectory: () => dir,
+  });
+  vm.runInContext(main.slice(main.indexOf('function cleanGradingPresetPayload('),
+    main.indexOf('function semverParts(')), context);
+  for (let i = 0; i < 500; i++) {
+    fsOrder.push(context.saveGradingPreset({ groupId: 'hdr-tone', name: 'Tone ' + i, values: {} }).id);
+  }
+  const saved = context.saveGradingPreset({ groupId: 'sdr-tone', name: 'SDR Tone', values: { strength: 3 } });
+  fsOrder.push(saved.id);
+  fs.writeFileSync(path.join(dir, 'manual.hdrf-grade.json'),
+    JSON.stringify({ groupId: 'sdr-tone', name: 'Manual', values: {} }));
+  fsOrder.push('manual.hdrf-grade.json');
+  const presets = context.listGradingPresets('sdr-tone');
+  assert.equal(presets.length, 2);
+  assert.equal(presets[0].name, 'Manual');
+  assert.equal(presets[1].id, saved.id);
+  assert.equal(presets[1].values.strength, 3);
+  assert.equal(context.listGradingPresets('hdr-tone').length, 500);
+});
