+
+test('packaged preset export can load its filename helper from bundled files', async t => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hdr-packaged-preset-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const pkg = require('../package.json');
+  const file = 'grading-preset-files.js';
+  const bundle = pkg.build.files.find(entry => entry.to === 'shared');
+  const appDir = path.join(dir, 'app');
+  const shared = path.join(appDir, bundle.to);
+  fs.mkdirSync(shared, { recursive: true });
+  if (bundle.filter.includes(file)) fs.copyFileSync(require.resolve('../../frontend/grading-preset-files'), path.join(shared, file));
+  let suggested;
+  const invoke = ipc({
+    async showSaveDialog(_parent, options) {
+      suggested = options.defaultPath;
+      return { canceled: true };
+    },
+  }, createRequire(path.join(appDir, 'main.js')));
+  const text = presets.encode([{ groupId: 'hdr-tone', name: 'Packed tone', values: {} }]);
+  assert.equal(await invoke('export', text), false);
+  assert.equal(suggested, 'Packed-tone-preset.json');
+});
