{
  "name": "hdr-finisher-desktop",
  "version": "0.7.1",
  "private": true,
  "description": "Electron desktop shell for HDR Finisher",
  "author": "HDR Finisher contributors",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/electron-smoke.js",
    "test:packaged": "node tests/electron-smoke.js --packaged",
    "pack:dir": "electron-builder --dir --win --x64",
    "pack:dir:mac": "electron-builder --dir --mac",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "org.hdrfinisher.app",
    "productName": "HDR Finisher",
    "afterPack": "scripts/after-pack.js",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/HDR Finisher Backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "notices/LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "notices/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "hdrfinisher",
          "name": "HDR Finisher Project",
          "description": "HDR Finisher editing project",
          "role": "Editor"
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.photography",
      "artifactName": "HDR-Finisher-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "fileAssociations": [
        {
          "ext": "hdrfinisher",
          "name": "HDR Finisher Project",
          "description": "HDR Finisher editing project",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "artifactName": "HDR-Finisher-${version}-macOS-${arch}.${ext}",
      "title": "HDR Finisher ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "artifactName": "HDR-Finisher-Setup-${version}-${arch}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "HDR-Finisher-Portable-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "../dist-electron",
      "buildResources": "assets"
    }
  }
}
